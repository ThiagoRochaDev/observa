# Copie para .env e ajuste se precisar. Nada aqui é obrigatório pra subir —
# Observa não pede segredo nenhum pra rodar: a chave de criptografia das
# credenciais dos conectores (data/secrets.key) e a API key exigida em toda
# rota /api (data/api_key) são geradas sozinhas no primeiro boot. Pegue a API
# key em `docker compose logs api` ou `cat data/api_key`.

# Porta onde a web fica exposta no host.
WEB_PORT=3000

# Porta onde a API fica exposta no host.
API_PORT=8080
