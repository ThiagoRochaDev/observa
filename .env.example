# Copie para .env e ajuste se precisar. Nada aqui é obrigatório pra subir —
# Observa não pede segredo nenhum pra rodar: a chave de criptografia das
# credenciais dos conectores (data/secrets.key) e a API key exigida em toda
# rota /api (data/api_key) são geradas sozinhas no primeiro boot. Pegue a API
# key em `docker compose logs api` ou `cat data/api_key`.

# Porta onde a web fica exposta no host.
WEB_PORT=3000

# Porta onde a API fica exposta no host.
API_PORT=8080

# Perfil de produção. Em development os segredos continuam sendo gerados em
# data/. Em production os três valores abaixo são obrigatórios e devem vir do
# secret manager da plataforma, nunca de um arquivo versionado.
ENVIRONMENT=development
OBSERVA_API_KEY=
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OBSERVA_SECRETS_KEY=
OBSERVA_SESSION_SECRET=
# JSON. Use [] quando web e API estiverem no mesmo origin atrás do proxy.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Segurança HTTP e operação.
SEED_DEMO_DATA=true
ENABLE_API_DOCS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=30
MAX_REQUEST_BODY_BYTES=2000000
TRUST_PROXY_HEADERS=false
