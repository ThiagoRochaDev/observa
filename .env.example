# Copie para .env e ajuste se precisar. Nada aqui é obrigatório pra subir —
# Observa não pede segredo nenhum pra rodar: a chave de criptografia das
# credenciais dos conectores é gerada sozinha no primeiro boot (data/secrets.key).

# Porta onde a web fica exposta no host.
WEB_PORT=3000

# Porta onde a API fica exposta no host.
API_PORT=8080
